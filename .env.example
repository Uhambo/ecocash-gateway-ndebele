# ============================================================================
#  .env.example — THE SACRED SCROLL
#
#  Step 1: Copy this file to .env       (cp .env.example .env)
#  Step 2: Fill in .env                 (NOT this file. THIS FILE GOES TO GITHUB.)
#  Step 3: Never, ever commit .env      (it's in .gitignore. Leave it there. Walk away.)
#
#  If you paste a real secret into THIS file and push it, a bot will find it
#  in about 40 seconds and you'll be explaining to EcoCash why someone in
#  another time zone is "testing" your merchant account. Don't be that person.
#  Full, lovingly unhinged instructions: README.md -> "Setting up your .env".
# ============================================================================

# ---- EcoCash Instant Payments (EIP): customer pays you via a USSD prompt ----
# From the developer portal -> Instant Payments. Yes, they're base64. No, don't decode them. Just paste.
ECOCASH_USERNAME=paste_your_base64_username_here_not_your_feelings
ECOCASH_PASSWORD=paste_your_base64_password_here_and_tell_no_one
ECOCASH_MERCHANT_CODE=the_sandbox_merchant_code
ECOCASH_MERCHANT_PIN=the_sandbox_merchant_pin_NOT_your_actual_bank_pin_why_would_you
ECOCASH_MERCHANT_NUMBER=the_sandbox_merchant_number

# ---- EcoCash Payment Gateway (EPG): you pay the customer ----
# From the developer portal -> Payment Gateway -> Credentials.
EPG_CLIENT_ID=your_epg_client_id
EPG_CLIENT_SECRET=your_epg_client_secret_which_is_called_SECRET_for_a_reason
EPG_API_USERNAME=epg-sandbox-user-v1
# Do NOT type your password here. Click "Generate" on the EPG playground page and paste THAT.
EPG_API_PASSWORD_ENCRYPTED=the_gibberish_the_generate_button_gave_you
# YOUR whitelisted, OTP-verified test number from the Test Numbers page. Not your ex's. Not this placeholder.
EPG_TEST_MSISDN=263770000000

# ---- Multi-merchant gateway ----
# Do NOT invent these. Run:  python -m gateway.keygen   and paste what it prints.
# "password123" is not a master key. It is a cry for help.
GATEWAY_MASTER_KEY=
GATEWAY_KEY_PEPPER=
GATEWAY_ADMIN_TOKEN=
GATEWAY_DATABASE_URL=sqlite:///./gateway.db
# Where EcoCash can reach this server. localhost is fine until you want callbacks; then it's very much not fine.
GATEWAY_PUBLIC_BASE_URL=http://localhost:8000
GATEWAY_ENV=development
# Leave empty until EcoCash hands you production access. Live keys are refused while these are empty. On purpose.
ECOCASH_EIP_LIVE_URL=
ECOCASH_EPG_LIVE_URL=
